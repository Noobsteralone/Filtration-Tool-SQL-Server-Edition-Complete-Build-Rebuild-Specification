# =============================================================================
# FT - Filtration Tool - Environment Configuration
# Copy this file to `.env` in the same directory and adjust the values for
# your machine. Never commit the real `.env` file.
# =============================================================================

APP_NAME=FT Filtration Tool
APP_ENV=production
APP_SECRET_KEY=change-this-to-a-long-random-string

# ---------------------------------------------------------------------------
# SQL Server connection
# ---------------------------------------------------------------------------
SQL_SERVER=LAP-S2M059
SQL_DATABASE=FT_Filtration
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=True
SQL_USERNAME=
SQL_PASSWORD=
# Extra ODBC connection attributes, semicolon separated, appended as-is.
SQL_EXTRA_ODBC_PARAMS=

# ---------------------------------------------------------------------------
# Local storage
# ---------------------------------------------------------------------------
# Root directory for uploads / job workspaces / reports / backups / logs.
# On Windows use a real path, e.g. D:\FT_Data
DATA_ROOT=./data

MAX_FILE_SIZE_GB=20
CSV_CHUNK_SIZE=100000
EXCEL_CHUNK_SIZE=50000

# ---------------------------------------------------------------------------
# Jobs / concurrency
# ---------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=1
PROGRESS_UPDATE_EVERY_ROWS=25000
PROGRESS_UPDATE_EVERY_SECONDS=3

# ---------------------------------------------------------------------------
# Retention / cleanup
# ---------------------------------------------------------------------------
UPLOAD_RETENTION_DAYS=1
REPORT_RETENTION_DAYS=30
TEMP_RETENTION_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIRECTORY=./data/backups

# ---------------------------------------------------------------------------
# Default business rules (used only to seed reference tables on first run;
# afterwards everything is editable from the Reference Lists screens)
# ---------------------------------------------------------------------------
DEFAULT_ALLOWED_TLDS=.com,.org,.edu,.us

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_SUPERADMIN_USERNAME=admin
DEFAULT_SUPERADMIN_PASSWORD=ChangeMe!123
DEFAULT_SUPERADMIN_EMAIL=admin@example.com

# CORS - comma separated list of allowed origins for the React dev server / build
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
